      "expo-image",
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.ciclapp.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCb5J9fEy53jG_bswMdwl2tnpPwKnybtfE"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.ciclapp.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCb5J9fEy53jG_bswMdwl2tnpPwKnybtfE"
      }
    }
  }
}
