{
  "expo": {
    "name": "Ciclapp",
    "slug": "ciclapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ciclapp",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CICLAPP necesita tu ubicación para mostrarte rutas ciclistas."
